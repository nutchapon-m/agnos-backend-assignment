# For developing
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agnos?sslmode=disable

# For deploy
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_NAME=
DB_SCHEMA=
DB_MAX_IDLE_CONNS=
DB_MAX_OPEN_CONNS=
DB_DISABLE_TLS=

CORS_ORIGINS=

# --- docker compose ---
# Read by docker-compose.yml through ${VAR:-default} interpolation. Every value
# below is optional; the default compose falls back to is shown.
# DB_HOST is not listed: inside the compose network it is fixed to postgres:5432.

# Host port nginx publishes; the container itself listens on 80. (default 8000)
HTTP_PORT=8000
# (default release)
GIN_MODE=release
